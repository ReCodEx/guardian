#!/usr/bin/env python3

import sys
import os
import shutil
from pathlib import Path

def error(msg, code):
    print(f"[extract] ERROR: {msg}", file=sys.stderr)
    sys.exit(code)

def main():
    if len(sys.argv) != 3:
        error(f"Wrong number of arguments. Usage: extract <archive> <destination>", 1)

    archive_path = Path(sys.argv[1])
    destination_path = Path(sys.argv[2])

    if not archive_path.is_file():
        error(f"Source archive '{archive_path}' does not exist or is not a regular file.", 2)

    if not destination_path.is_dir():
        error(f"Destination '{destination_path}' is not a directory.", 2)

    try:
        shutil.unpack_archive(str(archive_path), str(destination_path))
        print(f"[extract] Successfully extracted '{archive_path}' to '{destination_path}'")
    except shutil.ReadError:
        error(f"Unsupported archive format or corrupted archive: {archive_path}", 2)
    except Exception as e:
        error(f"Unhandled exception: {e}", 2)

if __name__ == "__main__":
    main()
