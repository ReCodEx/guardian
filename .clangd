CompileFlags:
  # Applied to every translation unit, on top of compile_commands.json.
  # Ensures headers opened standalone (most logic lives in .hpp files) are
  # parsed as C++23.
  Add:
    - -std=c++23
    - -Wall
  CompilationDatabase: build

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - modernize-*
      - readability-*
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - readability-magic-numbers
      # Linux/C convention: ints used directly in boolean contexts (fd, rc, etc.)
      - readability-implicit-bool-conversion
      # Don't push <time.h> -> <ctime> etc. We use C headers + global C symbols
      # (::time, ::strlen). include-cleaner maps those to the <X.h> form, so the
      # deprecation nudge just fights include-cleaner in a loop.
      - modernize-deprecated-headers

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

Index:
  Background: Build
  StandardLibrary: true
